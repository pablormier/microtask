# Template unit: one dashboard per user. Start it with
#   systemctl enable --now mt-web@alice
# It runs as the account mt-alice, which add-user.sh creates. It reads /etc/mt/alice.env
# (PORT, HOST_NAME, MT_PROXY_SECRET_FILE and MT_SIGN_OUT_URL) and serves the workspace folder
# /srv/mt/alice with the app in /opt/microtask/current. Caddy adds the secret in
# /etc/mt/alice.secret to every request, and the dashboard answers 403 without it.
# MT_SIGN_OUT_URL is the oauth2-proxy sign-out path, which the page shows as a Sign out link.
[Unit]
Description=microtask dashboard for %i
After=network.target

[Service]
Type=simple
User=mt-%i
Group=mt-%i
EnvironmentFile=/etc/mt/%i.env
WorkingDirectory=/srv/mt/%i
Environment=HOME=/srv/mt/%i
Environment=PYTHONDONTWRITEBYTECODE=1
# One shared, read-only app. upgrade.sh moves the 'current' link and restarts the services.
# --require-proxy-secret reads the secret from MT_PROXY_SECRET_FILE.
ExecStart=/opt/microtask/current/mt -R /srv/mt/%i web --no-open --host 127.0.0.1 --port ${PORT} --allow-host ${HOST_NAME} --require-proxy-secret
Restart=on-failure
RestartSec=3
UMask=0077
# mt web waits up to 60 seconds for a running sync after SIGTERM.
TimeoutStopSec=90

NoNewPrivileges=true
PrivateTmp=true
# strict leaves /opt/microtask read-only, which is what we want for the app.
ProtectSystem=strict
ProtectHome=true
# Every workspace has its own account, and its files are not readable by the others. These
# two lines also give this service an empty /srv/mt with only its own workspace bound in.
# ReadWritePaths stays because ProtectSystem=strict also makes the bind mount read-only.
TemporaryFileSystem=/srv/mt
BindPaths=/srv/mt/%i
ReadWritePaths=/srv/mt/%i
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
