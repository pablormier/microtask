# Template unit: one dashboard per user. Start it with
#   systemctl enable --now mt-web@alice
# It reads /etc/mt/alice.env (PORT and HOST_NAME) and serves the
# workspace folder /srv/mt/alice with the app in /opt/microtask/current.
[Unit]
Description=microtask dashboard for %i
After=network.target

[Service]
Type=simple
User=mt
Group=mt
EnvironmentFile=/etc/mt/%i.env
WorkingDirectory=/srv/mt/%i
Environment=HOME=/srv/mt/%i
Environment=PYTHONDONTWRITEBYTECODE=1
# One shared, read-only app. upgrade.sh moves the 'current' link and restarts the services.
ExecStart=/opt/microtask/current/mt -R /srv/mt/%i web --no-open --host 127.0.0.1 --port ${PORT} --allow-host ${HOST_NAME}
Restart=on-failure
RestartSec=3
UMask=0077
# mt web waits up to 60 seconds for a running sync after SIGTERM.
TimeoutStopSec=90

NoNewPrivileges=true
PrivateTmp=true
# strict leaves /opt/microtask read-only, which is what we want for the app.
ProtectSystem=strict
ProtectHome=true
# All dashboards run as the same account. These two lines give this service an
# empty /srv/mt with only its own workspace bound in, so it cannot read the
# other users' workspaces. ReadWritePaths stays because ProtectSystem=strict
# also makes the bind mount read-only.
TemporaryFileSystem=/srv/mt
BindPaths=/srv/mt/%i
ReadWritePaths=/srv/mt/%i
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
