{
	admin off
}

:8080 {
	basic_auth {
		# Both fixture accounts use the password microtask.
		alice $2a$06$hS2u8OeQJ0f9ywATOMllLO.4hulj6sMZ9YfZvEJrFqrKSX7kV9eeW
		bob $2a$06$tCT5GQTA9cLg81RPez8l0eZhLU7v8AttGqCs3V.2SD0wIq0u040J2
	}
	reverse_proxy shared:8000 {
		header_up Host {upstream_hostport}
		header_up -Authorization
		header_up X-Auth-Request-Email {http.auth.user.id}@example.test
		header_up X-Microtask-Proxy-Secret {$MT_PROXY_SECRET}
	}
}

# Personal dashboard for alice only. Like the mt-web@ service, it is a single-user
# dashboard that answers 403 to any request without the proxy secret.
:8081 {
	# The dashboard's Sign out link. Basic auth has no session to end, so this asks the
	# browser for the password again, which makes most browsers forget the stored one.
	handle /logout {
		header WWW-Authenticate "Basic realm=\"restricted\""
		respond "Signed out. Close this tab, or reload to sign in again." 401
	}
	handle {
		basic_auth {
			alice $2a$06$hS2u8OeQJ0f9ywATOMllLO.4hulj6sMZ9YfZvEJrFqrKSX7kV9eeW
		}
		reverse_proxy personal:8000 {
			header_up Host {upstream_hostport}
			header_up -Authorization
			header_up X-Microtask-Proxy-Secret {$MT_PERSONAL_SECRET}
		}
	}
}
