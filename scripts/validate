#!/usr/bin/env python3
"""Validate the microtask workspace (the trust boundary behind ./mt validate).

Orchestrates validation of every Markdown card in cards/ (kind comes from frontmatter):
  * has YAML frontmatter
  * has all required fields
  * task status is configured in policy
  * priority / type are valid
  * due is YYYY-MM-DD, YYYY-MM-DDTHH:MM:SS, or null
  * due_kind is consistent with due
  * metadata time fields are YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS
  * archived is a boolean when present
  * the configured doing-task limit is not exceeded
  * notes have the note schema and no task lifecycle fields
  * task ids are unique
  * card properties, comments, and saved time records are structurally valid
  * Markdown bodies remain opaque to structural validation

Internal --changes mode reads a JSON candidate/previous overlay from stdin and
validates affected cards plus only newly affected cross-card invariants. It never
copies or writes workspace data. The default command remains a complete audit.

Exits non-zero with a list of errors if validation fails.
"""
from __future__ import annotations

import json
from pathlib import Path
import sys

_here = Path(__file__).resolve().parent
sys.path.insert(0, str(_here))

import policy_parser
import validation


def main() -> int:
    arguments = sys.argv[1:]
    changes_mode = "--changes" in arguments
    if changes_mode:
        arguments.remove("--changes")
    explicit_root: Path | None = None
    if len(arguments) == 2 and arguments[0] == "--data-root":
        explicit_root = Path(arguments[1])
    elif arguments:
        print(f"error: unexpected arguments: {' '.join(arguments)}", file=sys.stderr)
        return 2

    try:
        repo_root = policy_parser.workspace_root()
        effective_policy = policy_parser.load_policy(repo_root)
    except (OSError, ValueError) as error:
        print("FAILED: invalid policy:", file=sys.stderr)
        for line in str(error).splitlines():
            print(f"  - {line}", file=sys.stderr)
        return 1

    data_root = explicit_root or repo_root
    if changes_mode:
        try:
            errors = validation.check_changes_request(data_root, effective_policy, json.load(sys.stdin))
        except (OSError, ValueError, TypeError, UnicodeError) as error:
            errors = [str(error)]
        if errors:
            print("FAILED: card changes failed validation:", file=sys.stderr)
            for error in errors:
                print(f"  - {error}", file=sys.stderr)
            return 1
        print("OK: validated card changes and affected cross-card invariants.")
        return 0

    report = validation.audit_workspace(data_root, effective_policy)
    if report.errors:
        print(f"FAILED: {len(report.errors)} error(s):", file=sys.stderr)
        for error in report.errors:
            print(f"  - {error}", file=sys.stderr)
        return 1

    for warning in report.warnings:
        print(f"WARNING: {warning}", file=sys.stderr)
    print(
        f"OK: validated {report.task_count} task file(s), {report.note_count} note file(s), "
        f"and {report.draft_count} draft file(s)."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
